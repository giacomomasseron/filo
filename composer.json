{
    "name": "giacomomasseron/filo",
    "description": "Filo — zero-extension PHP call tracer: a stream wrapper splices hooks into your code as it loads",
    "type": "library",
    "homepage": "https://giacomomasseron.github.io/filo/",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "nikic/php-parser": "^5.0",
        "ext-tokenizer": "*"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^6.12",
        "pestphp/pest": "^2.0 || ^3.0 || ^4.0 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5.62 || ^11.0 || ^12.0 || ^13.0"
    },
    "suggest": {
        "pestphp/pest": "toRunUnder()/toCall() expectations and automatic per-test trace artifacts",
        "phpunit/phpunit": "Filo\\Testing\\FiloAssertions trait and the TraceExtension"
    },
    "extra": {
        "pest": {
            "plugins": [
                "Filo\\Testing\\Pest\\Plugin"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Filo\\": "src/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Filo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "bin": [
        "bin/filo"
    ]
}
