{
    "name": "giacomomasseron/filo",
    "description": "Filo \u2014 zero-extension PHP call tracer: userland instrumentation via stream wrapper + AST rewriting",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "nikic/php-parser": "^5.0",
        "ext-tokenizer": "*"
    },
    "autoload": {
        "psr-4": {
            "Filo\\": "src/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "bin": [
        "bin/filo"
    ]
}
